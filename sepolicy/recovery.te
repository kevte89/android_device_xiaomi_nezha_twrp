# recovery.te — nezha recovery
# SPDX-License-Identifier: Apache-2.0

permissive recovery;
permissive hal_vibrator_default;

type vendor_fingerprint_data_file, file_type, data_file_type;
type vendor_hal_minkipcbinder_default_exec, exec_type, vendor_file_type, file_type;
type smcinvoke_device, dev_type;
type qsee_ipc_irq_spss_device, dev_type;
type qseecom_dma_heap_device, dev_type;
type qseecom_ufs_bsg_device, dev_type;
type qseecom_dynamic_device, dev_type;
type qseecom_persist_data_file, file_type;

hal_client_domain(recovery, hal_vibrator)
hal_client_domain(recovery, hal_weaver)

allow recovery hal_weaver_service:service_manager find;
allow recovery self:capability sys_rawio;
allow recovery smcinvoke_device:chr_file { open read write ioctl getattr };
allow recovery qsee_ipc_irq_spss_device:chr_file { open read write ioctl getattr };
allow recovery qseecom_ufs_bsg_device:chr_file { open read write ioctl getattr };
allow recovery qseecom_dma_heap_device:chr_file { open read write ioctl getattr };
allow recovery qseecom_dynamic_device:chr_file { open read write ioctl getattr };
allow recovery qseecom_persist_data_file:dir { search read open write getattr add_name remove_name };
allow recovery qseecom_persist_data_file:file { create read open write ioctl getattr setattr unlink };
allow init smcinvoke_device:chr_file getattr;
allow init qsee_ipc_irq_spss_device:chr_file getattr;
